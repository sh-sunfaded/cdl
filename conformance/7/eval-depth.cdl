function f5(x: number): number { return -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(f4(x))))))))))))))))); }
function f6(x: number): number { return -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(f5(x))))))))))))))))); }
