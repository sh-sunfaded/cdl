// §7 評価の再帰の深さ: 呼び出しをまたいで式の入れ子を数え、上限（128）を超えたら E5012（AUDIT P3）。
"use cdl 1";
import { Contrast } from "host:contrast";
function f0(x: number): number { return x; }
function f1(x: number): number { return -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(f0(x))))))))))))))))); }
function f2(x: number): number { return -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(f1(x))))))))))))))))); }
