// §6 key: `key` は props ではない。コンポーネントは props.key を読めず、props の型にも書けない（DECISIONS R3）。
"use cdl 1";
import { Contrast, Keybind } from "host:contrast";

function Reader(props: { name: string }): Element<Keybind> {
  return <Keybind keys={props.key} action={props.name} />;
}

function Declared(props: { key: string }): Element<Keybind> {
  return <Keybind keys="a" action="b" />;
}

export default (
  <Contrast>
    <Reader key="k" name="n" />
    <Keybind keys="a" action="b" {...{ key: "spread" }} />
  </Contrast>
);
