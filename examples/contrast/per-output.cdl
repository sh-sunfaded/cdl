// 出力（モニタ）ごとの scale で gap を変える設定（ルートが `Env` を受け取る関数。DECISIONS U1）。
"use cdl 1";
import { Contrast, Appearance, Animation } from "host:contrast";
import type { Env } from "host:contrast";

const BASE = px(8);

export default function App({ output }: Env): Element<Contrast> {
  return (
    <Contrast>
      <Appearance gap={BASE * output.scale} radius={BASE} />
      <Animation duration={ms(120)} />
    </Contrast>
  );
}
